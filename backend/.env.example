PORT=8091
HOST=0.0.0.0
NODE_ENV=development

# MongoDB — set USE_MEMORY_DB=false + run mongo for production persistence
MONGODB_URI=mongodb://127.0.0.1:27017/solana_dex
USE_MEMORY_DB=true

# Auth
JWT_SECRET=change-me-dev-secret-32chars-min
API_SECRET=dev-api-secret
HELIUS_WEBHOOK_SECRET=dev-api-secret

# Solana
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
PAPER_TRADING=true

# Jupiter
JUPITER_API_URL=https://quote-api.jup.ag/v6

# Pump.fun
PUMPFUN_API_URL=https://frontend-api.pump.fun

# Trading
MAX_TRADE_SOL=1
MAX_DAILY_TRADES=50
DEFAULT_SLIPPAGE_BPS=300

# Engines
SENTIMENT_POLL_MS=15000
ONCHAIN_POLL_MS=12000

# Rust trade registry (optional — logs copy intents for on-chain audit)
TRADE_REGISTRY_ENABLED=false
TRADE_REGISTRY_PROGRAM_ID=TradeRegistry1111111111111111111111111111111

LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
